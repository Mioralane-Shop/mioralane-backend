# Application
PORT=3000
NODE_ENV=development

# Database (MongoDB)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority&appName=MioralaneCluster

# JWT
# Must be at least 32 characters, and must NOT be a placeholder. The API refuses
# to start if this is the value the code falls back to (P1.6.2), because that
# string is public: a token minted from it would be accepted.
# Generate one with:  openssl rand -base64 48
# Left deliberately empty so that copying this file fails loudly instead of
# booting on a value that is already in the repository.
JWT_SECRET=
# Customer session lifetime.
JWT_EXPIRES_IN=7d
# Admin session lifetime (optional — defaults to 1h when unset).
ADMIN_JWT_EXPIRES_IN=1h

# ImageKit Configuration
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_endpoint_id
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key

# Security (P0-5) — every value below is optional and falls back to the default
# in src/config/ and src/middleware/rateLimiter.middleware.ts.

# Comma-separated origin allowlist that OVERRIDES the built-in list. Setting it
# in production is a tightening: the built-in list also trusts
# http://localhost:3000 (and friends), which this drops. Each entry must be an
# absolute http(s) origin — no wildcards, no bare hostnames, no paths.
CORS_ORIGINS=https://mioralane.com,https://www.mioralane.com,https://admin.mioralane.com

# Proxy hops in front of the app. Cloudflare -> Vercel is 1. Never set this
# higher than the real count: it lets a caller spoof its own IP via
# X-Forwarded-For and bypass the rate limiter.
TRUST_PROXY_HOPS=1

# Rate limiting (defaults shown). Read at app start, so a change needs a restart.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_GLOBAL_MAX=300
RATE_LIMIT_WRITE_MAX=60

# Cloudflare Turnstile (bot protection for login/register/checkout).
# Server-side secret used by POST /api/verify-turnstile to exchange a widget token
# at Cloudflare's Siteverify endpoint. NEVER put this in a front end — only the
# public NEXT_PUBLIC_TURNSTILE_SITE_KEY belongs there. Left empty, verification is
# disabled (the endpoint answers { success: false, reason: 'disabled' } instead of
# blocking), so a local or preview deployment still boots.
TURNSTILE_SECRET_KEY=
