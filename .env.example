# Application
# 5000 is the local convention: both front ends default to
# http://localhost:5000/api, and 3000 is the storefront's own dev port.
PORT=5000
NODE_ENV=development

# Database (MongoDB)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority&appName=MioralaneCluster

# JWT
# Must be at least 32 characters, and must NOT be a placeholder. The API refuses
# to start if this is the value the code falls back to (P1.6.2), because that
# string is public: a token minted from it would be accepted.
# Generate one with:  openssl rand -base64 48
# Left deliberately empty so that copying this file fails loudly instead of
# booting on a value that is already in the repository.
JWT_SECRET=
# Customer session lifetime.
JWT_EXPIRES_IN=7d
# Admin sessions are a separate, database-backed family: exactly 3 hours from OTP
# verification, configured under "Admin 2FA (OTP)" below.

# Google OAuth
# The client id the API verifies Google ID tokens against. It must be the same
# client as the storefront's `NEXT_PUBLIC_GOOGLE_CLIENT_ID`. Left empty, only
# Google sign-in stops working — the API still boots, because the code falls
# back to ''.
GOOGLE_CLIENT_ID=

# Password reset / transactional email (Brevo SMTP)
# Trusted storefront origin used to build reset links, as
# `${FRONTEND_URL}/reset-password?token=...`. Never derived from a request Host
# header. A trailing slash is tolerated and stripped.
FRONTEND_URL=http://localhost:3000
# Brevo's SMTP relay. Port 587 uses STARTTLS; port 465 uses implicit TLS.
# Without SMTP_HOST the API still boots, but reset emails cannot be sent.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# From address shown to the recipient. Brevo only accepts an authenticated
# sender here.

MAIL_FROM="Mioralane <noreply@mioralane.com>"

# Admin 2FA (OTP), sessions and account provisioning.
# The inbox every admin login OTP is emailed to. This is a DEPLOYMENT setting, not
# a property of the admin account, so several admins can share one destination.
# If it is unset, the admin login endpoint refuses to start a challenge (503)
# rather than guess an address. ADMIN_EMAIL is the old name, still accepted.
ADMIN_OTP_EMAIL=mioralaneshop@gmail.com
# How long a code stays valid. Default 5, allowed range 1-15 minutes.
ADMIN_OTP_TTL_MINUTES=5
# Admin session lifetime. Production is PINNED to 3 hours in code, so this value
# is only honoured outside production. Use it to prove expiry on staging without
# touching the production policy, e.g. ADMIN_SESSION_TTL_HOURS=1.
ADMIN_SESSION_TTL_HOURS=3
# Shared secret for POST /api/admin/auth/bootstrap (header:
# x-admin-bootstrap-secret). At least 32 characters:
#   openssl rand -base64 48
# Leave EMPTY in a deployment where the initial admin already exists — the
# endpoint then answers 503, which is how bootstrap is disabled. Never commit a
# value and never ship it to a front end.
ADMIN_BOOTSTRAP_SECRET=
# Password used by `npm run seed:admin` ONLY when it creates the account for
# the first time; a re-run never changes an existing password. Never hardcoded
# in source. Unset: the seed generates a random password and prints it once.
ADMIN_SEED_PASSWORD=

# ImageKit Configuration
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_endpoint_id
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key

# Security (P0-5) — every value below is optional and falls back to the default
# in src/config/ and src/middleware/rateLimiter.middleware.ts.

# Comma-separated origin allowlist that OVERRIDES the built-in list. Setting it
# in production is a tightening: the built-in list also trusts
# http://localhost:3000 (and friends), which this drops. Each entry must be an
# absolute http(s) origin — no wildcards, no bare hostnames, no paths.
CORS_ORIGINS=https://mioralane.com,https://www.mioralane.com,https://admin.mioralane.com

# Proxy hops in front of the app. Cloudflare -> Vercel is 1. Never set this
# higher than the real count: it lets a caller spoof its own IP via
# X-Forwarded-For and bypass the rate limiter.
TRUST_PROXY_HOPS=1

# Rate limiting (defaults shown). Read at app start, so a change needs a restart.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_GLOBAL_MAX=300
RATE_LIMIT_WRITE_MAX=60

# Cloudflare Turnstile (bot protection for login/register/checkout).
# Server-side secret used by POST /api/verify-turnstile to exchange a widget token
# at Cloudflare's Siteverify endpoint. NEVER put this in a front end — only the
# public NEXT_PUBLIC_TURNSTILE_SITE_KEY belongs there. Left empty, verification is
# disabled (the endpoint answers { success: false, reason: 'disabled' } instead of
# blocking), so a local or preview deployment still boots.
TURNSTILE_SECRET_KEY=
